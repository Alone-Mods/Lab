SPARSE ADD

#include <stdio.h>
int main() {
    int a[100][100], b[100][100];
    int s1[100][3], s2[100][3], sum[100][3];
    int row1, col1, row2, col2;
    int i, j, k1 = 1, k2 = 1, k = 1;

    // Input first matrix
    printf("Enter number of rows and columns of first matrix: ");
    scanf("%d %d", &row1, &col1);
    printf("Enter elements of first matrix:\n");
    for (i = 0; i < row1; i++)
        for (j = 0; j < col1; j++)
            scanf("%d", &a[i][j]);

    // Input second matrix
    printf("Enter number of rows and columns of second matrix: ");
    scanf("%d %d", &row2, &col2);
    printf("Enter elements of second matrix:\n");
    for (i = 0; i < row2; i++)
        for (j = 0; j < col2; j++)
            scanf("%d", &b[i][j]);

    // Check if addition is possible
    if (row1 != row2 || col1 != col2) {
        printf("Error: Matrices must have the same dimensions for addition.\n");
        return 0;
    }

    // Convert first matrix to sparse
    for (i = 0; i < row1; i++)
        for (j = 0; j < col1; j++)
            if (a[i][j] != 0) {
                s1[k1][0] = i;
                s1[k1][1] = j;
                s1[k1][2] = a[i][j];
                k1++;
            }
    s1[0][0] = row1;
    s1[0][1] = col1;
    s1[0][2] = k1 - 1;

    // Convert second matrix to sparse
    for (i = 0; i < row2; i++)
        for (j = 0; j < col2; j++)
            if (b[i][j] != 0) {
                s2[k2][0] = i;
                s2[k2][1] = j;
                s2[k2][2] = b[i][j];
                k2++;
            }
    s2[0][0] = row2;
    s2[0][1] = col2;
    s2[0][2] = k2 - 1;

    // Add sparse matrices
    i = 1;
    j = 1;
    while (i < k1 && j < k2) {
        if (s1[i][0] == s2[j][0] && s1[i][1] == s2[j][1]) {
            sum[k][0] = s1[i][0];
            sum[k][1] = s1[i][1];
            sum[k][2] = s1[i][2] + s2[j][2];
            i++;
            j++;
            k++;
        } else if (s1[i][0] < s2[j][0] || (s1[i][0] == s2[j][0] && s1[i][1] < s2[j][1])) {
            sum[k][0] = s1[i][0];
            sum[k][1] = s1[i][1];
            sum[k][2] = s1[i][2];
            i++;
            k++;
        } else {
            sum[k][0] = s2[j][0];
            sum[k][1] = s2[j][1];
            sum[k][2] = s2[j][2];
            j++;
            k++;
        }
    }

    // Remaining elements
    while (i < k1) {
        sum[k][0] = s1[i][0];
        sum[k][1] = s1[i][1];
        sum[k][2] = s1[i][2];
        i++;
        k++;
    }
    while (j < k2) {
        sum[k][0] = s2[j][0];
        sum[k][1] = s2[j][1];
        sum[k][2] = s2[j][2];
        j++;
        k++;
    }

    sum[0][0] = row1;
    sum[0][1] = col1;
    sum[0][2] = k - 1;

    // Print result
    printf("\nResultant Sparse Matrix (Triplet Form):\n");
    printf("Row\tCol\tVal\n");
    for (i = 0; i < k; i++)
        printf("%d\t%d\t%d\n", sum[i][0], sum[i][1], sum[i][2]);

    return 0;
}
